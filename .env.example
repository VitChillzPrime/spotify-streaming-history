# Copy to .env.local and fill in. .env.local is gitignored.

# Optional: Client ID of your Spotify app (developer.spotify.com/dashboard).
# Enables artist photos, top genres and saving playlists. Album art works without it.
# Add these redirect URIs to the app: http://127.0.0.1:3000/callback and https://<your-domain>/callback
# The Client ID is public (it ships to the browser), but don't commit your .env.local.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
